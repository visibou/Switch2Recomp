#version 450
#extension GL_KHR_shader_subgroup_ballot : require
// vkspv_ballot_per_lane's test (t_vk_ballot.c): the same counter, but the add's result is read (a slot for each lane), so the ballot must stay as it is
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Count { uint count; };
layout(set = 0, binding = 1) buffer Data { uint data[]; };
void main() {
    if (data[gl_GlobalInvocationID.x] == 0u) return;
    uint mask = subgroupBallot(true).x;
    uint leader = uint(findMSB(mask));
    uint n = uint(bitCount(mask));
    if (gl_SubgroupInvocationID == leader) data[gl_GlobalInvocationID.x] = atomicAdd(count, n);
}
